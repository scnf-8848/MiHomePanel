+// 换票缓存：miss_get_vendor 一次 0.7–1.0 s（冷启时含 TLS + token 登录），
+// 同一张票几十秒内完全够用。键里带 host——远程中继和局域网直连是两条不同的
+// 换票结果，混用会拨不通。
+//
+// 落盘（工作目录下 vendor-cache.json，0600）而不是只放内存，是因为本程序的
+// go2rtc 会因"换取流源"重启：内存缓存在重启后清零，而恰恰是重启后那次开播
+// 最需要这张票。文件里含 sign / 临时密钥，属凭据，权限与 go2rtc.yaml 同级。
+type vendorTicket struct {
+	URL string `json:"url"`
+	Exp int64  `json:"exp"` // Unix 秒
+}
+
+const (
+	vendorTTL  = 10 * time.Minute
+	vendorFile = "vendor-cache.json"
+)
+
+var (
+	vendorMu    sync.Mutex
+	vendorCache = map[string]vendorTicket{}
+)
+
+func vendorKey(u *url.URL) string {
+	return u.Query().Get("did") + "|" + u.Host
+}
+
+func loadVendorCache() {
+	data, err := os.ReadFile(vendorFile)
+	if err != nil {
+		return
+	}
+	var saved map[string]vendorTicket
+	if err = json.Unmarshal(data, &saved); err != nil {
+		return
+	}
+	now := time.Now().Unix()
+	vendorMu.Lock()
+	for key, ticket := range saved {
+		if ticket.Exp > now {
+			vendorCache[key] = ticket
+		}
+	}
+	vendorMu.Unlock()
+}
+
+// saveVendorCache 由调用方持锁调用
+func saveVendorCache() {
+	data, err := json.Marshal(vendorCache)
+	if err != nil {
+		return
+	}
+	if err = os.WriteFile(vendorFile, data, 0o600); err != nil {
+		log.Debug().Err(err).Msg("xiaomi: save vendor cache")
+	}
+}
+
+func cachedCameraURL(u *url.URL) (string, bool) {
+	vendorMu.Lock()
+	defer vendorMu.Unlock()
+	key := vendorKey(u)
+	ticket, ok := vendorCache[key]
+	if !ok {
+		return "", false
+	}
+	if time.Now().Unix() > ticket.Exp {
+		delete(vendorCache, key)
+		saveVendorCache()
+		return "", false
+	}
+	return ticket.URL, true
+}
+
+func storeCameraURL(u *url.URL, raw string) {
+	vendorMu.Lock()
+	vendorCache[vendorKey(u)] = vendorTicket{
+		URL: raw,
+		Exp: time.Now().Add(vendorTTL).Unix(),
+	}
+	saveVendorCache()
+	vendorMu.Unlock()
+}
+
+func dropCameraURL(u *url.URL) {
+	vendorMu.Lock()
+	delete(vendorCache, vendorKey(u))
+	saveVendorCache()
+	vendorMu.Unlock()
+}
+
+// warmAllTickets 把配置里每条 xiaomi 源都换一次票（串行即可：一台 0.7 s，
+// 三台约 2 s，都在后台）。失败不重试——真正拨号时还会再换一次。
+func warmAllTickets() {
+	for _, sources := range streams.GetAllSources() {
+		for _, raw := range sources {
+			if !strings.HasPrefix(raw, "xiaomi://") {
+				continue
+			}
+			u, err := url.Parse(raw)
+			if err != nil || u.User == nil {
+				continue
+			}
+			if _, ok := cachedCameraURL(u); ok {
+				continue
+			}
+			t0 := time.Now()
+			rawURL, err := getCameraURL(u)
+			if err != nil {
+				log.Warn().Err(err).Str("url", raw).Msg("xiaomi: warm ticket")
+				continue
+			}
+			storeCameraURL(u, rawURL)
+			log.Debug().Msgf("xiaomi: warm ticket %s %d ms",
+				vendorKey(u), time.Since(t0).Milliseconds())
+		}
+	}
+}
