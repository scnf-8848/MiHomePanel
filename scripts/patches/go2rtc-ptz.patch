+}
+
+// apiPtz 下发一条云台指令：GET /api/xiaomi/ptz?name=cam_<did>&op=1
+//
+// op: 1 左、2 右、3 上、4 下、5 校准。
+// 不带 name/op 时只回显能力，调用方用它判断这个构建到底支不支持云台
+// —— 官方构建没有这段代码，路由不存在会直接 404。
+func apiPtz(w http.ResponseWriter, r *http.Request) {
+	query := r.URL.Query()
+	name := query.Get("name")
+	rawOp := query.Get("op")
+
+	if name == "" || rawOp == "" {
+		api.ResponseJSON(w, map[string]any{"ok": true, "ptz": true})
+		return
+	}
+
+	op, err := strconv.Atoi(rawOp)
+	if err != nil || op < 1 || op > 5 {
+		api.ResponseJSON(w, map[string]any{"ok": false, "error": "op must be 1..5"})
+		return
+	}
+
+	stream := Get(name)
+	if stream == nil {
+		api.ResponseJSON(w, map[string]any{"ok": false, "error": "unknown stream: " + name})
+		return
+	}
+
+	sender, ok := stream.ActiveProducer().(motorSender)
+	if !ok {
+		// 流还没连上，或者这条流不是小米协议（比如本地文件 / 别的摄像头）
+		api.ResponseJSON(w, map[string]any{"ok": false, "error": "stream has no ptz producer"})
+		return
+	}
+
+	if err = sender.Motor(op); err != nil {
+		api.ResponseJSON(w, map[string]any{"ok": false, "error": err.Error()})
+		return
+	}
+
+	api.ResponseJSON(w, map[string]any{"ok": true})
+}
