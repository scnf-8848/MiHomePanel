+// ActiveProducer 返回第一个已经连上的 producer（都没连上时返回 nil）。
+// API 层用它拿到真正的协议对象，比如给小米摄像头发云台指令。
+func (s *Stream) ActiveProducer() core.Producer {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	for _, producer := range s.producers {
+		if producer.conn != nil {
+			return producer.conn
+		}
+	}
+	return nil
 }
 
